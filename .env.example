# BusinessFlow Enterprise ERP - Production Environment Configuration

# Database (PostgreSQL Connection String)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/businessflow_db?schema=public

# Authentication Secrets (Must be at least 32 characters in production)
JWT_SECRET=super-secret-jwt-key-for-businessflow-production-min-32-chars
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-for-businessflow-production-min-32-chars
COOKIE_SECRET=super-secret-cookie-key-for-businessflow-production

# App Runtime
NODE_ENV=development
PORT=3000

# Default Organization / Tenant ID
DEFAULT_TENANT_ID=org-apex-01
